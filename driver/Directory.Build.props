<Project>
  <!--
    WDK / SDK 通过 NuGet 获取（见 packages.config 与 BUILD.md），无需安装 WDK MSI。
    先执行: nuget restore packages.config -PackagesDirectory .\packages
  -->
  <PropertyGroup>
    <AivcWdkVersion>10.0.28000.2526</AivcWdkVersion>
    <AivcPackagesDir>$(MSBuildThisFileDirectory)packages\</AivcPackagesDir>
  </PropertyGroup>
  <Import Project="$(AivcPackagesDir)Microsoft.Windows.WDK.x64.$(AivcWdkVersion)\build\native\Microsoft.Windows.WDK.x64.props" Condition="Exists('$(AivcPackagesDir)Microsoft.Windows.WDK.x64.$(AivcWdkVersion)\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'"/>
  <Import Project="$(AivcPackagesDir)Microsoft.Windows.SDK.CPP.x64.$(AivcWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props" Condition="Exists('$(AivcPackagesDir)Microsoft.Windows.SDK.CPP.x64.$(AivcWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'"/>
  <Import Project="$(AivcPackagesDir)Microsoft.Windows.SDK.CPP.$(AivcWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.props" Condition="Exists('$(AivcPackagesDir)Microsoft.Windows.SDK.CPP.$(AivcWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.props')"/>
</Project>
